{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::222234418877:role/asistencia-cloudinit-execution",
      "Condition": {
        "StringEquals": {
